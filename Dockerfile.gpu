FROM python:3.13-slim
LABEL org.opencontainers.image.source="https://github.com/bmaged23/rainscope-ml" org.opencontainers.image.licenses="GPL-3.0"
WORKDIR /app
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
RUN pip install --no-cache-dir torch==2.8.0+cu126 --index-url https://download.pytorch.org/whl/cu126
RUN pip install --no-cache-dir tabm==0.0.3 rtdl-num-embeddings==0.0.12
COPY pyproject.toml LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home appuser
USER appuser
ENV RAINSCOPE_MODEL=/models/selected_model.joblib RAINSCOPE_DEVICE=cuda OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/ready')"
CMD ["uvicorn", "rainscope.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
